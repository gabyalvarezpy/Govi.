<div class="overlay" id="liveModal"><div class="modal"><div class="modal-head"><h2>Crear en GOVI</h2><button class="close" onclick="closeModal('liveModal')">×</button></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:10px"><button class="gift" onclick="closeModal('liveModal');openModal('postModal')"><span>▧</span><b>Publicación</b><small>Foto o vídeo</small></button><button class="gift" onclick="startLive()"><span>◉</span><b>Directo</b><small>En vivo con tu gente</small></button></div><p class="demo-note">La emisión real necesitará un servicio de vídeo en directo y conexión de cámara/micrófono.</p></div></div>
<div class="overlay" id="giftModal"><div class="modal"><div class="modal-head"><h2>Enviar un regalo 🎁</h2><button class="close" onclick="closeModal('giftModal')">×</button></div><div class="gift-grid"><button class="gift" onclick="sendGift('Corazón',10)"><span>💜</span><b>Corazón</b><small>10 monedas</small></button><button class="gift" onclick="sendGift('Estrella',50)"><span>⭐</span><b>Estrella</b><small>50 monedas</small></button><button class="gift" onclick="sendGift('Cohete',250)"><span>🚀</span><b>Cohete</b><small>250 monedas</small></button><button class="gift" onclick="sendGift('Ramo',500)"><span>💐</span><b>Ramo</b><small>500 monedas</small></button><button class="gift" onclick="sendGift('Diamante',1000)"><span>💎</span><b>Diamante</b><small>1.000 monedas</small></button><button class="gift" onclick="sendGift('Corona',2500)"><span>👑</span><b>Corona</b><small>2.500 monedas</small></button></div><p class="demo-note">Monedas y regalos ficticios para probar el diseño. No se realizan cargos ni pagos reales.</p></div></div>
<div class="overlay" id="earnModal"><div class="modal"><div class="modal-head"><h2>Centro de monetización ✦</h2><button class="close" onclick="closeModal('earnModal')">×</button></div><p style="font-size:13px;line-height:1.6;color:#9293A5">Una propuesta de requisitos iniciales. Los umbrales finales se definirán según las normas, la seguridad y la sostenibilidad económica de la plataforma.</p><div style="display:grid;gap:10px"><div class="panel" style="padding:13px"><b>🎁 Regalos en directos</b><p style="font-size:12px;color:#9293A5;margin:5px 0">Desde 500 seguidores + identidad verificada y normas cumplidas.</p></div><div class="panel" style="padding:13px"><b>⭐ Suscripciones de fans</b><p style="font-size:12px;color:#9293A5;margin:5px 0">Desde 2.000 seguidores + actividad mínima.</p></div><div class="panel" style="padding:13px"><b>▶ Reparto de ingresos por contenido</b><p style="font-size:12px;color:#9293A5;margin:5px 0">Desde 5.000 seguidores + visualizaciones válidas.</p></div><div class="panel" style="padding:13px"><b>🤝 Colaboraciones con marcas</b><p style="font-size:12px;color:#9293A5;margin:5px 0">Acceso progresivo según comunidad y calidad del contenido.</p></div></div><p class="demo-note">Los requisitos son ilustrativos, no una promesa de ingresos ni una oferta de pagos activa.</p></div></div>
<div class="overlay" id="authModal"><div class="modal"><div class="modal-head"><h2 id="authTitle">Únete a GOVI</h2><button class="close" onclick="closeModal('authModal')">×</button></div><div class="auth-fields"><input id="authName" placeholder="Tu nombre" autocomplete="name"><input id="authEmail" type="email" placeholder="Correo electrónico" autocomplete="email"><input id="authPassword" type="password" placeholder="Contraseña (mínimo 8 caracteres)" autocomplete="new-password"></div><div class="modal-actions"><button class="primary-btn" id="authSubmit" onclick="demoAuth()">Crear cuenta</button></div><button class="auth-switch" id="authSwitch" onclick="toggleAuthMode()">Ya tengo una cuenta · Iniciar sesión</button><p class="demo-note">El registro se conecta a GOVI mediante Supabase. Puede que tengas que confirmar tu correo electrónico.</p></div></div>
<div class="toast" id="toast"></div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const SUPABASE_URL='https://ennfigjdboxpkmfhttze.supabase.co';
const SUPABASE_PUBLISHABLE_KEY='sb_publishable_Jhya35mcZXssCNI9u3uzNQ_CfcvaTyH';
const nexoraSupabase=window.supabase.createClient(SUPABASE_URL,SUPABASE_PUBLISHABLE_KEY);
function toast(message){const el=document.getElementById('toast');el.textContent=message;el.classList.add('show');clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>el.classList.remove('show'),2400)}
function openModal(id){document.getElementById(id).classList.add('show')}
function closeModal(id){document.getElementById(id).classList.remove('show')}
function likePost(button){button.classList.toggle('liked');button.textContent=button.classList.contains('liked')?'♥ Te gusta':'♡ Me gusta';const stat=button.closest('.post').querySelector('.stats-likes');let n=Number((stat.textContent.match(/\d+/)||['0'])[0]);stat.textContent='💜 '+(n+(button.classList.contains('liked')?1:-1))+' reacciones'}
function toggleComments(button){const area=button.closest('.post').querySelector('.comments');area.classList.toggle('open');if(area.classList.contains('open'))area.querySelector('input').focus()}
function sharePost(){if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText('Mira esta publicación en GOVI (prototipo)').then(()=>toast('Enlace de demostración copiado')).catch(()=>toast('Publicación lista para compartir'))}else toast('Publicación lista para compartir')}
function follow(button){button.textContent=button.textContent==='Seguir'?'Siguiendo':'Seguir';button.style.background=button.textContent==='Siguiendo'?'#6D4AFF':'transparent';button.style.color=button.textContent==='Siguiendo'?'white':'var(--site-primary)'}
function renderSavedPost(item,currentUser){const post=document.createElement('article');post.className='post panel';const head=document.createElement('div');head.className='post-head';const avatar=document.createElement('div');avatar.className='avatar';avatar.textContent='G';const info=document.createElement('div');const author=document.createElement('div');author.className='post-author';author.textContent=item.user_id===currentUser?.id?(currentUser.user_metadata?.full_name||currentUser.email||'Tú'):'Usuario GOVI';const meta=document.createElement('div');meta.className='post-meta';meta.textContent=new Date(item.created_at).toLocaleString('es-ES')+' · Público';info.append(author,meta);head.append(avatar,info);if(item.user_id===currentUser?.id){const more=document.createElement('button');more.className='more';more.textContent='···';more.setAttribute('aria-label','Editar o borrar publicación');more.onclick=()=>managePost(item);head.append(more)}const content=document.createElement('p');content.className='post-text';content.textContent=item.content||'';const stats=document.createElement('div');stats.className='post-stats';stats.innerHTML='<span class="stats-likes">💜 0 reacciones</span><span>0 comentarios</span>';const buttons=document.createElement('div');buttons.className='post-buttons';buttons.innerHTML='<button onclick="likePost(this)">♡ Me gusta</button><button onclick="toggleComments(this)">◯ Comentar</button><button onclick="sharePost()">↗ Compartir</button>';const comments=document.createElement('div');comments.className='comments';const input=document.createElement('input');input.placeholder='Escribe un comentario…';comments.append(input);post.append(head,content,stats,buttons,comments);return post}
async function managePost(item){const choice=prompt('Escribe EDITAR para modificar o BORRAR para eliminar tu publicación:');if(!choice)return;if(choice.trim().toLowerCase()==='editar'){const updated=prompt('Modifica el texto de tu publicación:',item.content||'');if(updated===null)return;if(!updated.trim()){toast('La publicación no puede quedar vacía');return}const {error}=await nexoraSupabase.from('posts').update({content:updated.trim()}).eq('id',item.id).eq('user_id',item.user_id);if(error){toast('No se pudo editar: '+error.message);return}await loadSavedPosts();toast('Publicación actualizada')}else if(choice.trim().toLowerCase()==='borrar'){if(!confirm('¿Seguro que quieres borrar esta publicación?'))return;const {error}=await nexoraSupabase.from('posts').delete().eq('id',item.id).eq('user_id',item.user_id);if(error){toast('No se pudo borrar: '+error.message);return}await loadSavedPosts();toast('Publicación eliminada')}}
async function loadSavedPosts(){const feed=document.getElementById('feed');const {data:{user}}=await nexoraSupabase.auth.getUser();const {data,error}=await nexoraSupabase.from('posts').select('id,user_id,content,media_url,created_at').order('created_at',{ascending:false});if(error){toast('No se pudieron cargar las publicaciones: '+error.message);return}feed.replaceChildren();(data||[]).forEach(item=>feed.append(renderSavedPost(item,user)))}
async function publishPost(){const field=document.getElementById('postText');const value=field.value.trim();if(!value){toast('Escribe algo antes de publicar');return}const {data:{user}}=await nexoraSupabase.auth.getUser();if(!user){toast('Inicia sesión para publicar');openModal('authModal');return}const button=document.querySelector('#postModal .primary-btn');button.disabled=true;button.textContent='Publicando…';try{const {error}=await nexoraSupabase.from('posts').insert({user_id:user.id,content:value,media_url:null});if(error)throw error;field.value='';closeModal('postModal');await loadSavedPosts();toast('¡Publicación guardada en GOVI!')}catch(error){toast('No se pudo guardar: '+error.message)}finally{button.disabled=false;button.textContent='Publicar'}}
function startLive(){closeModal('liveModal');toast('El directo de prueba estaría listo para configurar');setTimeout(()=>openModal('giftModal'),450)}
function sendGift(name,coins){closeModal('giftModal');toast('¡'+name+' enviado! '+coins+' monedas de prueba')}
function showEarnings(){openModal('earnModal')}
let authMode='register';
function toggleAuthMode(){authMode=authMode==='register'?'login':'register';document.getElementById('authTitle').textContent=authMode==='register'?'Únete a GOVI':'Bienvenido de nuevo';document.getElementById('authName').style.display=authMode==='register'?'block':'none';document.getElementById('authPassword').setAttribute('autocomplete',authMode==='register'?'new-password':'current-password');document.getElementById('authSubmit').textContent=authMode==='register'?'Crear cuenta':'Iniciar sesión';document.getElementById('authSwitch').textContent=authMode==='register'?'Ya tengo una cuenta · Iniciar sesión':'No tengo cuenta · Registrarme'}
async function demoAuth(){const name=document.getElementById('authName').value.trim();const email=document.getElementById('authEmail').value.trim();const password=document.getElementById('authPassword').value;const submit=document.getElementById('authSubmit');if(authMode==='register'&&!name){toast('Escribe tu nombre');return}if(!email||!email.includes('@')){toast('Introduce un correo válido');return}if(password.length<8){toast('La contraseña debe tener 8 caracteres como mínimo');return}submit.disabled=true;submit.textContent='Conectando…';try{if(authMode==='register'){const {data,error}=await nexoraSupabase.auth.signUp({email,password,options:{data:{full_name:name}}});if(error)throw error;closeModal('authModal');toast(data.session?'¡Cuenta creada! Ya estás dentro.':'¡Registro enviado! Revisa tu correo para confirmar la cuenta.')}else{const {data,error}=await nexoraSupabase.auth.signInWithPassword({email,password});if(error)throw error;closeModal('authModal');document.querySelector('.top-actions .avatar').textContent=(data.user.user_metadata.full_name||email).charAt(0).toUpperCase();toast('¡Bienvenido a GOVI!')}}catch(error){toast(error.message||'No se pudo completar la operación')}finally{submit.disabled=false;submit.textContent=authMode==='register'?'Crear cuenta':'Iniciar sesión'}}
async function refreshGoviSession(){const {data:{session}}=await nexoraSupabase.auth.getSession();if(session){const label=session.user.user_metadata?.full_name||session.user.email||'G';document.querySelector('.top-actions .avatar').textContent=label.charAt(0).toUpperCase();await loadSavedPosts()}else{document.getElementById('feed').innerHTML='';}}
function setSection(el){document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));el.classList.add('active');toast('Vista '+el.dataset.section+' · contenido de demostración')}
function setSectionByName(name){const el=[...document.querySelectorAll('.nav-item')].find(n=>n.dataset.section===name);if(el)setSection(el)}
document.getElementById('searchInput').addEventListener('input',e=>{const q=e.target.value.toLowerCase();document.querySelectorAll('#feed .post').forEach(p=>p.style.display=(p.innerText+' '+(p.dataset.search||'')).toLowerCase().includes(q)?'block':'none')});
document.querySelectorAll('.overlay').forEach(el=>el.addEventListener('click',e=>{if(e.target===el)el.classList.remove('show')}));
nexoraSupabase.auth.onAuthStateChange(()=>{setTimeout(refreshGoviSession,0)});
refreshGoviSession();
</script>
</body>
